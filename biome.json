{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "files": {
    "includes": [
      "**",
      "!**/build",
      "!**/dist",
      "!**/.flue-vite",
      "!**/.flue-vite.wrangler.jsonc",
      "!**/src/bundles.generated.ts",
      "!**/.wrangler",
      "!**/.guardrail",
      "!**/tools/oxlint/anti-slop",
      "!**/*.svelte"
    ]
  }
}
