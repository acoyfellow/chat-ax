{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-ax",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ChatRoomDO" },
      { "name": "CONNECTOR_VAULT", "class_name": "ConnectorVaultDO" },
      { "name": "AGENT", "class_name": "AgentDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoomDO", "ConnectorVaultDO", "AgentDO"] }],
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "chat-ax-files" }],
  "vars": {
    "WORKER_NAME": "chat-ax"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
